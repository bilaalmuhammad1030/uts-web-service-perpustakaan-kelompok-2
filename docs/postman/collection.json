{
  "info": {
    "name": "Kelompok 2 — Perpustakaan v1.1.0",
    "description": "Jalankan berurutan setelah migrate --seed. Isi password pada environment lokal, bukan collection bersama. Membuat satu buku demo lalu mengarsipkannya; riwayat audit tetap disimpan. Metadata menerima normal atau fallback sesuai kondisi jaringan; normal/gagal deterministik diuji dengan Http::fake di feature tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Login petugas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Respons JSON', () => pm.response.to.be.json);",
              "const d=pm.response.json().data; pm.environment.set('token',d.token); pm.environment.set('run_id',Date.now().toString());",
              "pm.test('Isi respons sesuai', () => { pm.expect(d.token_type).to.eql('Bearer'); pm.expect(d.token).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
